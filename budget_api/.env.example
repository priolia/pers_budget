# Конфигурация Budget API
# Скопируйте этот файл в .env и измените значения

# Хост и порт
API_HOST=0.0.0.0
API_PORT=5000

# API ключ для безопасности (ИЗМЕНИТЕ НА СВОЙ!)
API_KEY=your-secret-api-key-here

# Разрешенные источники запросов (CORS)
# Укажите ваш GitHub Pages домен
ALLOWED_ORIGINS=https://your-username.github.io

# Хранение бэкапов (дней)
BACKUP_RETENTION_DAYS=30
